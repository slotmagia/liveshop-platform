{
  "apiVersion": "liveshop.io/v1",
  "kind": "ModuleRelease",
  "metadata": {
    "id": "platform",
    "name": "Platform Control Plane",
    "version": "5.1.0"
  },
  "spec": {
    "backend": {
      "service": "platform",
      "origin": "http://127.0.0.1:8082",
      "httpRoutes": null,
      "grpc": {
        "service": "liveshop.platform.v1.PlatformRegistryService",
        "contractVersion": "1.0.0",
        "endpoint": "dns:///platform:9082",
        "transportSecurity": "tls1.3-mtls-spiffe",
        "methods": [
          {
            "name": "GetRouteSnapshot",
            "fullMethod": "/liveshop.platform.v1.PlatformRegistryService/GetRouteSnapshot",
            "summary": "读取活动路由快照",
            "description": "向经过授权的基础设施工作负载发布当前活动模块 HTTP 路由和单调递增修订号。",
            "invocation": "unary",
            "idempotency": "safe",
            "recommendedDeadlineMs": 5000,
            "requiredPermissions": [
              "platform.registry.routes.read"
            ],
            "requestFields": [],
            "responseFields": [
              {
                "name": "revision",
                "type": "integer",
                "required": true,
                "description": "路由快照修订号"
              },
              {
                "name": "routes",
                "type": "array",
                "required": true,
                "description": "活动路由列表"
              }
            ]
          },
          {
            "name": "GetActiveCapabilitySnapshot",
            "fullMethod": "/liveshop.platform.v1.PlatformRegistryService/GetActiveCapabilitySnapshot",
            "summary": "读取活动能力快照",
            "description": "仅向 Identity 工作负载发布由当前活动 Manifest 派生的版本化权限与贡献快照。",
            "invocation": "unary",
            "idempotency": "safe",
            "recommendedDeadlineMs": 5000,
            "requiredPermissions": [
              "platform.registry.active-capabilities.read"
            ],
            "requestFields": [],
            "responseFields": [
              {
                "name": "registry_revision",
                "type": "integer",
                "required": true,
                "description": "能力目录修订号"
              },
              {
                "name": "modules",
                "type": "array",
                "required": true,
                "description": "活动模块权限、贡献、路由与动作目录"
              }
            ]
          }
        ]
      }
    },
    "permissions": null,
    "contributions": null
  }
}
