{
  "surface": "admin",
  "prefix": "/admin/platform/settings",
  "operations": [
    {
      "id": "platform.admin.settings.catalog.get",
      "method": "GET",
      "path": "/admin/platform/settings/catalog",
      "summary": "查询配置分类及表单元数据",
      "description": "返回 Platform 拥有的配置分组、子类和字段 schema。直播/交易/注册等业务配置不进入本目录。Admin 按字段渲染表单，不自行维护 JSON 结构。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.settings.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "分类目录",
          "fields": [
            {
              "name": "groups",
              "type": "array",
              "description": "大类→子类→字段，不含密钥"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.settings.list",
      "method": "GET",
      "path": "/admin/platform/settings",
      "summary": "查询平台配置",
      "description": "返回当前租户的平台配置文档。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.settings.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "配置文档列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "配置文档"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.settings.get",
      "method": "GET",
      "path": "/admin/platform/settings/{namespace}",
      "summary": "读取命名空间配置",
      "description": "读取指定 namespace 的版本化配置文档。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.settings.read"
      ],
      "requestFields": [
        {
          "name": "namespace",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "配置命名空间"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "配置文档",
          "fields": [
            {
              "name": "value",
              "type": "object",
              "description": "配置值"
            },
            {
              "name": "version",
              "type": "integer",
              "description": "当前版本"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.settings.update",
      "method": "PUT",
      "path": "/admin/platform/settings/{namespace}",
      "summary": "写入命名空间配置",
      "description": "使用 expectedVersion 乐观锁写入已登记 namespace 的配置值。字段必须属于 catalog，禁止自由 JSON 和密钥键。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.settings.write"
      ],
      "requestFields": [
        {
          "name": "namespace",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "配置命名空间"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "期望版本"
        },
        {
          "name": "value",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "配置值"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新配置文档",
          "fields": [
            {
              "name": "version",
              "type": "integer",
              "description": "最新版本"
            }
          ]
        },
        {
          "status": 409,
          "description": "版本冲突",
          "fields": [
            {
              "name": "message",
              "type": "string",
              "description": "冲突原因"
            }
          ]
        }
      ]
    }
  ]
}
