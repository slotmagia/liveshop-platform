{
  "surface": "admin",
  "prefix": "/admin/platform/track-events",
  "operations": [
    {
      "id": "platform.admin.track-events.list",
      "method": "GET",
      "path": "/admin/platform/track-events",
      "summary": "查询上报事件",
      "description": "按商户、店铺、端、事件名、主体和时间窗口只读浏览原始埋点。租户键为 merchantId + shopId。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.track-event.read"
      ],
      "requestFields": [
        { "name": "merchantId", "location": "query", "type": "integer", "description": "商户 ID" },
        { "name": "shopId", "location": "query", "type": "integer", "description": "店铺 ID" },
        { "name": "surface", "location": "query", "type": "string", "description": "shop / merch / admin / live" },
        { "name": "eventName", "location": "query", "type": "string", "description": "事件名" },
        { "name": "eventType", "location": "query", "type": "string", "description": "事件类型" },
        { "name": "subject", "location": "query", "type": "string", "description": "Identity 主体" },
        { "name": "anonymousId", "location": "query", "type": "string", "description": "匿名 ID" },
        { "name": "startMs", "location": "query", "type": "integer", "description": "clientTs 起（毫秒，含）" },
        { "name": "endMs", "location": "query", "type": "integer", "description": "clientTs 止（毫秒，含）" },
        { "name": "page", "location": "query", "type": "integer", "description": "页码，默认 1" },
        { "name": "pageSize", "location": "query", "type": "integer", "description": "每页条数，默认 20，上限 100" }
      ],
      "responses": [
        {
          "status": 200,
          "description": "上报事件页",
          "fields": [
            { "name": "items", "type": "array", "description": "事件行" },
            { "name": "total", "type": "integer", "description": "匹配总数" }
          ]
        }
      ]
    }
  ]
}
