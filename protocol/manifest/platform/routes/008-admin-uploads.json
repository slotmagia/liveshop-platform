{
  "surface": "admin",
  "prefix": "/uploads",
  "operations": [
    {
      "id": "platform.admin.storage.objects.get",
      "method": "GET",
      "path": "/uploads/{folder}/{name}",
      "summary": "读取本地存储对象",
      "description": "按对象键直出本地磁盘文件字节。测试文件形如 /uploads/_storage_test/ping-1.txt。浏览器可直接打开，无需 Host hash 或模块会话。",
      "authentication": "public",
      "idempotency": "safe",
      "requiredPermissions": [],
      "requestFields": [
        {
          "name": "folder",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "对象键第一段"
        },
        {
          "name": "name",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "对象键第二段"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "对象原文",
          "fields": []
        },
        {
          "status": 404,
          "description": "对象不存在",
          "fields": []
        }
      ]
    }
  ]
}
