{
  "surface": "admin",
  "prefix": "/admin/platform/sms",
  "operations": [
    {
      "id": "platform.admin.sms.drivers.list",
      "method": "GET",
      "path": "/admin/platform/sms/drivers",
      "summary": "查询短信驱动及表单元数据",
      "description": "返回后端驱动注册表拥有的字段、必填、密钥和占位说明；Admin 不自行维护驱动条件表单。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.sms.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "驱动定义列表",
          "fields": [
            {
              "name": "drivers",
              "type": "array",
              "description": "每个驱动携带 fields 表单元数据，不含任何密钥值"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.sms.channels.list",
      "method": "GET",
      "path": "/admin/platform/sms/channels",
      "summary": "查询短信通道目录",
      "description": "返回通道、驱动、区域路由、优先级、启停、版本和密钥脱敏状态。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.sms.read"
      ],
      "requestFields": [
        {
          "name": "keyword",
          "location": "query",
          "type": "string",
          "description": "编码或名称"
        },
        {
          "name": "driver",
          "location": "query",
          "type": "string",
          "description": "驱动"
        },
        {
          "name": "lifecycle",
          "location": "query",
          "type": "string",
          "description": "ACTIVE 或 RETIRED"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "通道列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "不返回任何密钥明文"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.sms.channels.update",
      "method": "PUT",
      "path": "/admin/platform/sms/channels/{code}",
      "summary": "版本化保存短信通道",
      "description": "新增或按 expectedVersion 修改通道；新建默认启用，编辑沿用当前启用状态；密钥只写，空值保留。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "稳定通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "新建为 0"
        },
        {
          "name": "driver",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "驱动"
        },
        {
          "name": "secrets",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "按字段 KEEP/REPLACE/CLEAR；值只写"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道脱敏视图",
          "fields": [
            {
              "name": "channel",
              "type": "object",
              "description": "含最新 version"
            }
          ]
        },
        {
          "status": 409,
          "description": "expectedVersion 或 commandKey 冲突",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.channels.enable",
      "method": "POST",
      "path": "/admin/platform/sms/channels/{code}/enable",
      "summary": "启用短信通道",
      "description": "版本化切换通道启用状态，不改配置。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.channels.disable",
      "method": "POST",
      "path": "/admin/platform/sms/channels/{code}/disable",
      "summary": "停用短信通道",
      "description": "版本化切换通道启用状态，不改配置。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.channels.retire",
      "method": "POST",
      "path": "/admin/platform/sms/channels/{code}/retire",
      "summary": "退役短信通道",
      "description": "将通道进入 RETIRED 终态并保留历史版本。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "已退役通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.test",
      "method": "POST",
      "path": "/admin/platform/sms/test",
      "summary": "测试发送短信",
      "description": "指定通道或按号码前缀路由后发送测试短信；Mock 不真发并回填验证码。",
      "authentication": "module-session",
      "idempotency": "non-idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "channelCode",
          "location": "body",
          "type": "string",
          "description": "指定通道；空则按路由"
        },
        {
          "name": "phone",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "E.164 手机号"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "发送结果",
          "fields": [
            {
              "name": "ok",
              "type": "boolean",
              "description": "是否被网关接受"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.sms.regions.list",
      "method": "GET",
      "path": "/admin/platform/sms/regions",
      "summary": "查询短信区域目录",
      "description": "返回区号主数据、启停和生命周期。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.sms.read"
      ],
      "requestFields": [
        {
          "name": "keyword",
          "location": "query",
          "type": "string",
          "description": "区号、名称或 ISO2"
        },
        {
          "name": "lifecycle",
          "location": "query",
          "type": "string",
          "description": "ACTIVE 或 RETIRED"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "区域列表",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.regions.update",
      "method": "PUT",
      "path": "/admin/platform/sms/regions/{code}",
      "summary": "版本化保存短信区域",
      "description": "新增或按 expectedVersion 修改区域；编码由区号数字部分派生且创建后不可改。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "区号数字部分"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "新建为 0"
        },
        {
          "name": "dialCode",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "E.164 区号"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新区域",
          "fields": []
        },
        {
          "status": 409,
          "description": "版本或命令冲突",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.regions.enable",
      "method": "POST",
      "path": "/admin/platform/sms/regions/{code}/enable",
      "summary": "启用短信区域",
      "description": "版本化切换区域启用状态。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "区域编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新区域",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.regions.disable",
      "method": "POST",
      "path": "/admin/platform/sms/regions/{code}/disable",
      "summary": "停用短信区域",
      "description": "版本化切换区域启用状态。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "区域编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新区域",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.regions.retire",
      "method": "POST",
      "path": "/admin/platform/sms/regions/{code}/retire",
      "summary": "退役短信区域",
      "description": "区域进入 RETIRED 终态；仍被活动通道引用时拒绝。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "区域编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "已退役区域",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.sms.merchant-grants.get",
      "method": "GET",
      "path": "/admin/platform/sms/merchant-grants",
      "summary": "查询商户短信区域开通",
      "description": "按 app_id + commercial_id 返回开通区号；未配置视为不限制。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.sms.read"
      ],
      "requestFields": [
        {
          "name": "grantAppId",
          "location": "query",
          "type": "integer",
          "required": true,
          "description": "店铺 app_id"
        },
        {
          "name": "shopId",
          "location": "query",
          "type": "integer",
          "required": true,
          "description": "店铺 commercial_id"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "开通范围",
          "fields": [
            {
              "name": "unrestricted",
              "type": "boolean",
              "description": "空选择表示不限制"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.sms.merchant-grants.replace",
      "method": "PUT",
      "path": "/admin/platform/sms/merchant-grants",
      "summary": "设置商户短信区域开通",
      "description": "按 app_id + commercial_id 写入开通区号；空数组表示不限制。不把 commercial_id 映射为 merchant_id。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.sms.manage"
      ],
      "requestFields": [
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "新建为 0"
        },
        {
          "name": "grantAppId",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "店铺 app_id"
        },
        {
          "name": "shopId",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "店铺 commercial_id"
        },
        {
          "name": "dialCodes",
          "location": "body",
          "type": "array",
          "required": true,
          "description": "开通区号；空=不限制"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新开通范围",
          "fields": []
        }
      ]
    }
  ]
}
