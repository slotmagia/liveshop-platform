{
  "surface": "admin",
  "prefix": "/admin/platform/notify-channels",
  "operations": [
    {
      "id": "platform.admin.notify-channels.in-app.get",
      "method": "GET",
      "path": "/admin/platform/notify-channels/in-app",
      "summary": "读取站内信驱动配置",
      "description": "返回内置 inbox 驱动的启用状态。无外部密钥。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": ["platform.notify-channel.read"],
      "requestFields": [],
      "responses": [
        { "status": 200, "description": "站内信配置", "fields": [
          { "name": "driver", "type": "string", "description": "固定 inbox" },
          { "name": "enabled", "type": "boolean", "description": "是否接受新的站内投递" }
        ] }
      ]
    },
    {
      "id": "platform.admin.notify-channels.in-app.update",
      "method": "PUT",
      "path": "/admin/platform/notify-channels/in-app",
      "summary": "版本化保存站内信驱动配置",
      "description": "commandKey + expectedVersion。停用后新的 IN_APP Dispatch 记 FAILED_PERMANENT。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": ["platform.notify-channel.manage"],
      "requestFields": [
        { "name": "commandKey", "location": "body", "type": "string", "required": true, "description": "稳定幂等键" },
        { "name": "expectedVersion", "location": "body", "type": "integer", "required": true, "description": "当前版本" },
        { "name": "enabled", "location": "body", "type": "boolean", "required": true, "description": "是否启用 inbox" }
      ],
      "responses": [
        { "status": 200, "description": "最新配置", "fields": [] },
        { "status": 409, "description": "版本或命令冲突", "fields": [] }
      ]
    }
  ]
}
