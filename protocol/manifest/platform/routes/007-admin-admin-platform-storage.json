{
  "surface": "admin",
  "prefix": "/admin/platform/storage",
  "operations": [
    {
      "id": "platform.admin.storage.drivers.list",
      "method": "GET",
      "path": "/admin/platform/storage/drivers",
      "summary": "查询存储驱动及表单元数据",
      "description": "返回后端驱动注册表拥有的字段、必填、密钥和占位说明；Admin 不自行维护驱动条件表单。local 驱动无表单字段。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.storage.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "驱动定义列表",
          "fields": [
            {
              "name": "drivers",
              "type": "array",
              "description": "每个驱动携带 fields 表单元数据，不含任何密钥值"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.list",
      "method": "GET",
      "path": "/admin/platform/storage/channels",
      "summary": "查询存储通道目录",
      "description": "返回通道、驱动、默认标记、启停、版本和密钥脱敏状态。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.storage.read"
      ],
      "requestFields": [
        {
          "name": "keyword",
          "location": "query",
          "type": "string",
          "description": "编码或名称"
        },
        {
          "name": "driver",
          "location": "query",
          "type": "string",
          "description": "驱动"
        },
        {
          "name": "lifecycle",
          "location": "query",
          "type": "string",
          "description": "ACTIVE 或 RETIRED"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "通道列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "不返回任何密钥明文"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.update",
      "method": "PUT",
      "path": "/admin/platform/storage/channels/{code}",
      "summary": "版本化保存存储通道",
      "description": "新增或按 expectedVersion 修改通道；新建默认启用且非默认，编辑沿用当前启用与默认状态；密钥只写，空值保留。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "稳定通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "新建为 0"
        },
        {
          "name": "driver",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "驱动"
        },
        {
          "name": "secrets",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "按字段 KEEP/REPLACE/CLEAR；值只写"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道脱敏视图",
          "fields": [
            {
              "name": "channel",
              "type": "object",
              "description": "含最新 version"
            }
          ]
        },
        {
          "status": 409,
          "description": "expectedVersion 或 commandKey 冲突",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.enable",
      "method": "POST",
      "path": "/admin/platform/storage/channels/{code}/enable",
      "summary": "启用存储通道",
      "description": "版本化切换通道启用状态。停用会同时取消默认标记。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.disable",
      "method": "POST",
      "path": "/admin/platform/storage/channels/{code}/disable",
      "summary": "停用存储通道",
      "description": "版本化切换通道启用状态。停用会同时取消默认标记。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.default",
      "method": "POST",
      "path": "/admin/platform/storage/channels/{code}/default",
      "summary": "将存储通道设为默认",
      "description": "目标必须已启用。事务内取消其它通道的默认标记。新上传立即切换，已有文件不迁移。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.retire",
      "method": "POST",
      "path": "/admin/platform/storage/channels/{code}/retire",
      "summary": "退役存储通道",
      "description": "将通道进入 RETIRED 终态并保留历史版本；同时取消启用和默认标记。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新通道",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.storage.channels.test",
      "method": "POST",
      "path": "/admin/platform/storage/channels/{code}/test",
      "summary": "测试写入存储通道",
      "description": "使用已保存明文配置写入探测文件 _storage_test/ping-{ms}.txt。本地通道返回 /uploads/{folder}/{name}，云通道返回公网 URL，浏览器均可直接打开。",
      "authentication": "module-session",
      "idempotency": "non-idempotent",
      "requiredPermissions": [
        "platform.storage.manage"
      ],
      "requestFields": [
        {
          "name": "code",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "通道编码"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "试写结果",
          "fields": [
            {
              "name": "ok",
              "type": "boolean",
              "description": "是否写入成功"
            },
            {
              "name": "url",
              "type": "string",
              "description": "可直接打开的访问 URL"
            }
          ]
        }
      ]
    }
  ]
}
