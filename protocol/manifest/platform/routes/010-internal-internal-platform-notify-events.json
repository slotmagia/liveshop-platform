{
  "surface": "internal",
  "prefix": "/internal/platform/notify-events",
  "operations": [
    {
      "id": "platform.internal.notify-events.deliveries.create",
      "method": "POST",
      "path": "/internal/platform/notify-events/deliveries",
      "summary": "统一 Dispatch 通知",
      "description": "业务模块在本模块事务提交后调用。运行时查找键是 eventKey。调用方模块必须等于 eventKey 前缀。浏览器禁止调用。",
      "authentication": "workload-identity",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.notify-event.dispatch"
      ],
      "requestFields": [
        {
          "name": "eventKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "必须出现在调用方模块的活动声明中"
        },
        {
          "name": "deliveryKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "全局幂等键，禁止使用请求 UUID"
        },
        {
          "name": "merchantId",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "店铺范围商户"
        },
        {
          "name": "shopId",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "店铺；允许 0 仅当事件声明允许平台级"
        },
        {
          "name": "recipients",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "按启用渠道提供 phone、email、subject"
        },
        {
          "name": "variables",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "键集合必须等于声明变量"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "各渠道 Delivery",
          "fields": [
            {
              "name": "deliveries",
              "type": "array",
              "description": "deliveryId、channel、status、deduped"
            }
          ]
        },
        {
          "status": 409,
          "description": "相同 deliveryKey 但请求摘要不同",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.internal.notify-events.deliveries.get",
      "method": "GET",
      "path": "/internal/platform/notify-events/deliveries/{deliveryId}",
      "summary": "读取一次渠道投递",
      "description": "查询 Delivery 终态或 UNKNOWN 恢复。与 gRPC GetDelivery 同一 logic。",
      "authentication": "workload-identity",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.notify-event.dispatch"
      ],
      "requestFields": [
        {
          "name": "deliveryId",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "Dispatch 返回的投递 id"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "投递证据",
          "fields": []
        },
        {
          "status": 404,
          "description": "投递不存在",
          "fields": []
        }
      ]
    }
  ]
}
