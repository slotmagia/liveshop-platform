{
  "surface": "admin",
  "prefix": "/admin/platform/notify-events",
  "operations": [
    {
      "id": "platform.admin.notify-events.list",
      "method": "GET",
      "path": "/admin/platform/notify-events",
      "summary": "查询通知事件目录",
      "description": "返回当前活动 Registry 快照投影出的通知事件、渠道策略和投递模式。Admin 不能新建未声明的事件。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.notify-event.read"
      ],
      "requestFields": [
        {
          "name": "module",
          "location": "query",
          "type": "string",
          "description": "模块 id"
        },
        {
          "name": "channel",
          "location": "query",
          "type": "string",
          "description": "已开启的渠道：SMS、EMAIL 或 IN_APP"
        },
        {
          "name": "keyword",
          "location": "query",
          "type": "string",
          "description": "title、eventKey 或 operationId"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "事件列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "按模块与 operation 分组展示所需的行"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.notify-events.get",
      "method": "GET",
      "path": "/admin/platform/notify-events/{eventKey}",
      "summary": "读取一个通知事件",
      "description": "返回声明与现行策略（含每渠道 templateCode）。eventKey 按字面匹配，含点号。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.notify-event.read"
      ],
      "requestFields": [
        {
          "name": "eventKey",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "模块声明的事件键"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "事件详情",
          "fields": []
        },
        {
          "status": 404,
          "description": "事件未投影或不可 Dispatch",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.notify-events.policy.replace",
      "method": "PUT",
      "path": "/admin/platform/notify-events/{eventKey}/policy",
      "summary": "版本化保存渠道策略",
      "description": "按 expectedVersion 与 commandKey 保存投递模式、渠道开关和每渠道 templateCode。开启的渠道必须选择未退役且变量覆盖事件声明的模板。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.notify-event.manage"
      ],
      "requestFields": [
        {
          "name": "eventKey",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "事件键"
        },
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前策略版本"
        },
        {
          "name": "dispatchMode",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "SYNC、ASYNC 或 SCHEDULED"
        },
        {
          "name": "delaySeconds",
          "location": "body",
          "type": "integer",
          "description": "仅 SCHEDULED，0..2592000"
        },
        {
          "name": "channels",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "allowedChannels 子集：enabled 与 templateCode"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新策略",
          "fields": []
        },
        {
          "status": 409,
          "description": "expectedVersion 或 commandKey 冲突",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.notify-events.deliveries.list",
      "method": "GET",
      "path": "/admin/platform/notify-events/{eventKey}/deliveries",
      "summary": "查询事件投递记录",
      "description": "只读返回该事件的渠道 Delivery 证据，不含密钥或未渲染的调用方变量以外的原文绕过。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.notify-event.read"
      ],
      "requestFields": [
        {
          "name": "eventKey",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "事件键"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "投递列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "按时间倒序"
            }
          ]
        }
      ]
    }
  ]
}
