{
  "surface": "admin",
  "prefix": "/admin/platform/email",
  "operations": [
    {
      "id": "platform.admin.email.drivers.list",
      "method": "GET",
      "path": "/admin/platform/email/drivers",
      "summary": "查询邮件驱动及表单元数据",
      "description": "返回后端驱动注册表拥有的字段、必填、密钥、选项和占位说明；Admin 不自行维护驱动条件表单。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.email.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "驱动定义列表",
          "fields": [
            {
              "name": "drivers",
              "type": "array",
              "description": "每个驱动携带 fields 表单元数据，不含任何密钥值"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.admin.email.config.get",
      "method": "GET",
      "path": "/admin/platform/email/config",
      "summary": "取当前邮件发信配置",
      "description": "返回平台级单例发信配置。尚未保存时 version 为 0。不返回任何密钥明文。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.email.read"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "当前配置脱敏视图",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.email.config.update",
      "method": "PUT",
      "path": "/admin/platform/email/config",
      "summary": "版本化保存邮件发信配置",
      "description": "新增或按 expectedVersion 修改单例发信配置；新建默认启用，编辑沿用当前启用状态；密钥只写，空值保留。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.email.manage"
      ],
      "requestFields": [
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "新建为 0"
        },
        {
          "name": "driver",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "驱动"
        },
        {
          "name": "secrets",
          "location": "body",
          "type": "object",
          "required": true,
          "description": "按字段 KEEP/REPLACE/CLEAR；值只写"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新配置脱敏视图",
          "fields": [
            {
              "name": "config",
              "type": "object",
              "description": "含最新 version"
            }
          ]
        },
        {
          "status": 409,
          "description": "expectedVersion 或 commandKey 冲突",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.email.config.enable",
      "method": "POST",
      "path": "/admin/platform/email/config/enable",
      "summary": "启用邮件发信",
      "description": "版本化切换发信启用状态，不改 SMTP 配置。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.email.manage"
      ],
      "requestFields": [
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新配置",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.email.config.disable",
      "method": "POST",
      "path": "/admin/platform/email/config/disable",
      "summary": "停用邮件发信",
      "description": "版本化切换发信启用状态，不改 SMTP 配置。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.email.manage"
      ],
      "requestFields": [
        {
          "name": "commandKey",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "稳定幂等键"
        },
        {
          "name": "expectedVersion",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "当前版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "最新配置",
          "fields": []
        }
      ]
    },
    {
      "id": "platform.admin.email.config.test",
      "method": "POST",
      "path": "/admin/platform/email/config/test",
      "summary": "发一封测试邮件",
      "description": "使用已保存的明文配置试发。mock 驱动不连接 SMTP。",
      "authentication": "module-session",
      "idempotency": "non-idempotent",
      "requiredPermissions": [
        "platform.email.manage"
      ],
      "requestFields": [
        {
          "name": "to",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "收件人"
        },
        {
          "name": "subject",
          "location": "body",
          "type": "string",
          "description": "留空使用默认测试主题"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "试发结果",
          "fields": [
            {
              "name": "ok",
              "type": "boolean",
              "description": "是否发送成功"
            }
          ]
        }
      ]
    }
  ]
}
