{
  "apiVersion": "liveshop.io/v1",
  "kind": "ModuleRelease",
  "metadata": {
    "id": "platform",
    "name": "Platform Control Plane",
    "version": "2.0.1"
  },
  "spec": {
    "backend": {
      "service": "platform",
      "origin": "http://127.0.0.1:8082",
      "httpRoutes": [
        {
          "surface": "admin",
          "prefix": "/admin/platform/iam",
          "operations": [
            {
              "id": "platform.iam.permissions.list",
              "method": "GET",
              "path": "/admin/platform/iam/permissions",
              "summary": "查询权限目录",
              "description": "返回所有模块同步到 Platform 的权限定义。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "权限定义列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "权限数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.departments.list",
              "method": "GET",
              "path": "/admin/platform/iam/departments",
              "summary": "查询部门",
              "description": "返回当前租户部门树。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "部门列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "部门数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.departments.put",
              "method": "PUT",
              "path": "/admin/platform/iam/departments/{departmentId}",
              "summary": "创建或更新部门",
              "description": "使用 expectedVersion 乐观锁写入部门并校验父级无环。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [
                {
                  "name": "departmentId",
                  "location": "path",
                  "type": "integer",
                  "required": true,
                  "description": "部门 ID"
                },
                {
                  "name": "expectedVersion",
                  "location": "body",
                  "type": "integer",
                  "required": true,
                  "description": "期望版本"
                },
                {
                  "name": "name",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "部门名称"
                },
                {
                  "name": "status",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "ACTIVE 或 DISABLED"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "写入后的部门",
                  "fields": [
                    {
                      "name": "department",
                      "type": "object",
                      "description": "部门数据"
                    }
                  ]
                },
                {
                  "status": 409,
                  "description": "版本冲突",
                  "fields": [
                    {
                      "name": "message",
                      "type": "string",
                      "description": "冲突原因"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.roles.list",
              "method": "GET",
              "path": "/admin/platform/iam/roles",
              "summary": "查询角色",
              "description": "返回当前租户角色。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "角色列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "角色数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.roles.put",
              "method": "PUT",
              "path": "/admin/platform/iam/roles/{roleId}",
              "summary": "创建或更新角色",
              "description": "使用 expectedVersion 乐观锁写入普通角色。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [
                {
                  "name": "roleId",
                  "location": "path",
                  "type": "integer",
                  "required": true,
                  "description": "角色 ID"
                },
                {
                  "name": "expectedVersion",
                  "location": "body",
                  "type": "integer",
                  "required": true,
                  "description": "期望版本"
                },
                {
                  "name": "name",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "角色名称"
                },
                {
                  "name": "status",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "角色状态"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "写入后的角色",
                  "fields": [
                    {
                      "name": "role",
                      "type": "object",
                      "description": "角色数据"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.roles.policy.put",
              "method": "PUT",
              "path": "/admin/platform/iam/roles/{roleId}/policy",
              "summary": "替换角色策略",
              "description": "原子替换角色权限和数据范围，并使用 expectedVersion 防止并发覆盖。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [
                {
                  "name": "roleId",
                  "location": "path",
                  "type": "integer",
                  "required": true,
                  "description": "角色 ID"
                },
                {
                  "name": "expectedVersion",
                  "location": "body",
                  "type": "integer",
                  "required": true,
                  "description": "期望版本"
                },
                {
                  "name": "permissions",
                  "location": "body",
                  "type": "array",
                  "required": true,
                  "description": "权限码数组"
                },
                {
                  "name": "scopes",
                  "location": "body",
                  "type": "array",
                  "required": true,
                  "description": "数据范围数组"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "最新角色策略",
                  "fields": [
                    {
                      "name": "policy",
                      "type": "object",
                      "description": "角色策略"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.iam.subjects.assignment.put",
              "method": "PUT",
              "path": "/admin/platform/iam/subjects/{subject}/assignment",
              "summary": "替换用户分配",
              "description": "替换用户的角色和部门分配。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [
                {
                  "name": "subject",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "用户 Subject"
                },
                {
                  "name": "roleIds",
                  "location": "body",
                  "type": "array",
                  "required": true,
                  "description": "角色 ID 数组"
                },
                {
                  "name": "departments",
                  "location": "body",
                  "type": "array",
                  "required": true,
                  "description": "部门分配"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "分配完成",
                  "fields": []
                }
              ]
            },
            {
              "id": "platform.iam.subjects.access.get",
              "method": "GET",
              "path": "/admin/platform/iam/subjects/{subject}/access",
              "summary": "查询有效授权",
              "description": "计算并返回指定用户的权限和数据范围。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.iam.manage"
              ],
              "requestFields": [
                {
                  "name": "subject",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "用户 Subject"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "有效授权",
                  "fields": [
                    {
                      "name": "permissions",
                      "type": "array",
                      "description": "权限码"
                    },
                    {
                      "name": "dataScopes",
                      "type": "array",
                      "description": "数据范围"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "surface": "admin",
          "prefix": "/admin/platform/registry",
          "operations": [
            {
              "id": "platform.registry.modules.list",
              "method": "GET",
              "path": "/admin/platform/registry/modules",
              "summary": "查询模块生命周期",
              "description": "返回模块、不可变发布、摘要和当前激活版本。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.registry.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "模块发布列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "模块数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.registry.capabilities.list",
              "method": "GET",
              "path": "/admin/platform/registry/capabilities",
              "summary": "查询模块能力目录",
              "description": "返回所有不可变发布的 HTTP、gRPC、权限和前端能力契约。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.registry.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "机器可读能力目录",
                  "fields": [
                    {
                      "name": "revision",
                      "type": "integer",
                      "description": "注册中心修订号"
                    },
                    {
                      "name": "items",
                      "type": "array",
                      "description": "模块能力数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.registry.modules.activate",
              "method": "POST",
              "path": "/admin/platform/registry/modules/{moduleId}/activate",
              "summary": "激活模块版本",
              "description": "在串行化事务中校验路由冲突、同步权限目录、更新唯一激活版本并记录审计。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.registry.manage"
              ],
              "requestFields": [
                {
                  "name": "moduleId",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "模块 ID"
                },
                {
                  "name": "version",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "发布版本"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "激活完成",
                  "fields": []
                },
                {
                  "status": 409,
                  "description": "发布不存在或路由冲突",
                  "fields": [
                    {
                      "name": "message",
                      "type": "string",
                      "description": "冲突原因"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.registry.modules.deactivate",
              "method": "DELETE",
              "path": "/admin/platform/registry/modules/{moduleId}/activation",
              "summary": "停用模块",
              "description": "移除模块当前激活版本并记录审计；Platform 自身不可停用。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.registry.manage"
              ],
              "requestFields": [
                {
                  "name": "moduleId",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "模块 ID"
                }
              ],
              "responses": [
                {
                  "status": 204,
                  "description": "停用完成",
                  "fields": []
                },
                {
                  "status": 404,
                  "description": "模块未激活",
                  "fields": [
                    {
                      "name": "message",
                      "type": "string",
                      "description": "错误原因"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "surface": "admin",
          "prefix": "/admin/platform/settings",
          "operations": [
            {
              "id": "platform.settings.list",
              "method": "GET",
              "path": "/admin/platform/settings",
              "summary": "查询平台配置",
              "description": "返回当前租户的平台配置文档。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.settings.read"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "配置文档列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "配置文档"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.settings.get",
              "method": "GET",
              "path": "/admin/platform/settings/{namespace}",
              "summary": "读取命名空间配置",
              "description": "读取指定 namespace 的版本化配置文档。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.settings.read"
              ],
              "requestFields": [
                {
                  "name": "namespace",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "配置命名空间"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "配置文档",
                  "fields": [
                    {
                      "name": "value",
                      "type": "object",
                      "description": "配置值"
                    },
                    {
                      "name": "version",
                      "type": "integer",
                      "description": "当前版本"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.settings.put",
              "method": "PUT",
              "path": "/admin/platform/settings/{namespace}",
              "summary": "写入命名空间配置",
              "description": "使用 expectedVersion 乐观锁写入配置并记录操作者。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.settings.write"
              ],
              "requestFields": [
                {
                  "name": "namespace",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "配置命名空间"
                },
                {
                  "name": "expectedVersion",
                  "location": "body",
                  "type": "integer",
                  "required": true,
                  "description": "期望版本"
                },
                {
                  "name": "value",
                  "location": "body",
                  "type": "object",
                  "required": true,
                  "description": "配置值"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "最新配置文档",
                  "fields": [
                    {
                      "name": "version",
                      "type": "integer",
                      "description": "最新版本"
                    }
                  ]
                },
                {
                  "status": 409,
                  "description": "版本冲突",
                  "fields": [
                    {
                      "name": "message",
                      "type": "string",
                      "description": "冲突原因"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "surface": "admin",
          "prefix": "/admin/platform/audit",
          "operations": [
            {
              "id": "platform.audit.events.list",
              "method": "GET",
              "path": "/admin/platform/audit/events",
              "summary": "查询审计事件",
              "description": "按当前租户返回最近审计事件。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.audit.read"
              ],
              "requestFields": [
                {
                  "name": "limit",
                  "location": "query",
                  "type": "integer",
                  "description": "返回数量上限"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "审计事件列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "审计事件"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "surface": "admin",
          "prefix": "/admin/platform/identity",
          "operations": [
            {
              "id": "platform.identity.accounts.list",
              "method": "GET",
              "path": "/admin/platform/identity/accounts",
              "summary": "查询后台账户",
              "description": "返回当前租户的平台端和商户端后台账户。",
              "authentication": "module-session",
              "idempotency": "safe",
              "requiredPermissions": [
                "platform.identity.manage"
              ],
              "requestFields": [],
              "responses": [
                {
                  "status": 200,
                  "description": "后台账户列表",
                  "fields": [
                    {
                      "name": "items",
                      "type": "array",
                      "description": "账户数组"
                    }
                  ]
                }
              ]
            },
            {
              "id": "platform.identity.accounts.put",
              "method": "PUT",
              "path": "/admin/platform/identity/accounts/{realm}/{subject}",
              "summary": "创建或更新后台账户",
              "description": "使用 expectedVersion 更新账户；改密或停用会撤销全部刷新会话。",
              "authentication": "module-session",
              "idempotency": "idempotent",
              "requiredPermissions": [
                "platform.identity.manage"
              ],
              "requestFields": [
                {
                  "name": "realm",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "PLATFORM 或 MERCHANT"
                },
                {
                  "name": "subject",
                  "location": "path",
                  "type": "string",
                  "required": true,
                  "description": "稳定 Subject"
                },
                {
                  "name": "expectedVersion",
                  "location": "body",
                  "type": "integer",
                  "required": true,
                  "description": "期望版本"
                },
                {
                  "name": "username",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "登录账号"
                },
                {
                  "name": "status",
                  "location": "body",
                  "type": "string",
                  "required": true,
                  "description": "账户状态"
                },
                {
                  "name": "password",
                  "location": "body",
                  "type": "string",
                  "format": "password",
                  "description": "新密码；更新时可留空"
                }
              ],
              "responses": [
                {
                  "status": 200,
                  "description": "最新账户",
                  "fields": [
                    {
                      "name": "account",
                      "type": "object",
                      "description": "账户信息"
                    }
                  ]
                },
                {
                  "status": 409,
                  "description": "版本冲突",
                  "fields": [
                    {
                      "name": "message",
                      "type": "string",
                      "description": "冲突原因"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "grpc": {
        "service": "liveshop.platform.v1.PlatformRegistryService",
        "contractVersion": "1.0.0",
        "endpoint": "dns:///platform:9082",
        "transportSecurity": "tls1.3-mtls-spiffe",
        "methods": [
          {
            "name": "GetRouteSnapshot",
            "fullMethod": "/liveshop.platform.v1.PlatformRegistryService/GetRouteSnapshot",
            "summary": "读取活动路由快照",
            "description": "向经过授权的基础设施工作负载发布当前活动模块 HTTP 路由和单调递增修订号。",
            "invocation": "unary",
            "idempotency": "safe",
            "recommendedDeadlineMs": 5000,
            "requiredPermissions": [
              "platform.registry.routes.read"
            ],
            "requestFields": [],
            "responseFields": [
              {
                "name": "revision",
                "type": "integer",
                "required": true,
                "description": "路由快照修订号"
              },
              {
                "name": "routes",
                "type": "array",
                "required": true,
                "description": "活动路由列表"
              }
            ]
          },
          {
            "name": "GetCapabilityCatalog",
            "fullMethod": "/liveshop.platform.v1.PlatformRegistryService/GetCapabilityCatalog",
            "summary": "读取模块能力目录",
            "description": "读取由不可变发布 Manifest 派生的完整模块能力目录和当前修订号。",
            "invocation": "unary",
            "idempotency": "safe",
            "recommendedDeadlineMs": 5000,
            "requiredPermissions": [
              "platform.registry.capabilities.read"
            ],
            "requestFields": [],
            "responseFields": [
              {
                "name": "revision",
                "type": "integer",
                "required": true,
                "description": "能力目录修订号"
              },
              {
                "name": "items",
                "type": "array",
                "required": true,
                "description": "模块能力目录"
              }
            ]
          }
        ]
      }
    },
    "permissions": [
      {
        "code": "platform.iam.manage",
        "name": "管理角色与组织",
        "resource": "platform.iam",
        "action": "manage",
        "description": "管理部门、角色、授权和数据范围。"
      },
      {
        "code": "platform.registry.manage",
        "name": "管理模块生命周期",
        "resource": "platform.registry",
        "action": "manage",
        "description": "查看能力目录并激活或停用模块版本。"
      },
      {
        "code": "platform.registry.routes.read",
        "name": "读取路由快照",
        "resource": "platform.registry.routes",
        "action": "read",
        "description": "允许受信工作负载读取活动模块路由快照。"
      },
      {
        "code": "platform.registry.capabilities.read",
        "name": "读取能力目录",
        "resource": "platform.registry.capabilities",
        "action": "read",
        "description": "允许受信工作负载读取不可变发布能力目录。"
      },
      {
        "code": "platform.settings.read",
        "name": "查看平台配置",
        "resource": "platform.settings",
        "action": "read",
        "description": "读取平台配置文档。"
      },
      {
        "code": "platform.settings.write",
        "name": "修改平台配置",
        "resource": "platform.settings",
