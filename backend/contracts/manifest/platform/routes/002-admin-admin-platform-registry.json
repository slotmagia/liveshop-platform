{
  "surface": "admin",
  "prefix": "/admin/platform/registry",
  "operations": [
    {
      "id": "platform.registry.modules.list",
      "method": "GET",
      "path": "/admin/platform/registry/modules",
      "summary": "查询模块生命周期",
      "description": "返回模块、不可变发布、摘要和当前激活版本。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.registry.manage"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "模块发布列表",
          "fields": [
            {
              "name": "items",
              "type": "array",
              "description": "模块数组"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.registry.capabilities.list",
      "method": "GET",
      "path": "/admin/platform/registry/capabilities",
      "summary": "查询模块能力目录",
      "description": "返回所有不可变发布的 HTTP、gRPC、权限和前端能力契约。",
      "authentication": "module-session",
      "idempotency": "safe",
      "requiredPermissions": [
        "platform.registry.manage"
      ],
      "requestFields": [],
      "responses": [
        {
          "status": 200,
          "description": "机器可读能力目录",
          "fields": [
            {
              "name": "revision",
              "type": "integer",
              "description": "注册中心修订号"
            },
            {
              "name": "items",
              "type": "array",
              "description": "模块能力数组"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.registry.modules.activate",
      "method": "POST",
      "path": "/admin/platform/registry/modules/{moduleId}/activate",
      "summary": "激活模块版本",
      "description": "在串行化事务中校验路由冲突、同步权限目录、更新唯一激活版本并记录审计。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.registry.manage"
      ],
      "requestFields": [
        {
          "name": "moduleId",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "模块 ID"
        },
        {
          "name": "version",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "发布版本"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "激活完成",
          "fields": []
        },
        {
          "status": 409,
          "description": "发布不存在或路由冲突",
          "fields": [
            {
              "name": "message",
              "type": "string",
              "description": "冲突原因"
            }
          ]
        }
      ]
    },
    {
      "id": "platform.registry.modules.deactivate",
      "method": "DELETE",
      "path": "/admin/platform/registry/modules/{moduleId}/activation",
      "summary": "停用模块",
      "description": "移除模块当前激活版本并记录审计；Platform 自身不可停用。",
      "authentication": "module-session",
      "idempotency": "idempotent",
      "requiredPermissions": [
        "platform.registry.manage"
      ],
      "requestFields": [
        {
          "name": "moduleId",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "模块 ID"
        }
      ],
      "responses": [
        {
          "status": 204,
          "description": "停用完成",
          "fields": []
        },
        {
          "status": 404,
          "description": "模块未激活",
          "fields": [
            {
              "name": "message",
              "type": "string",
              "description": "错误原因"
            }
          ]
        }
      ]
    }
  ]
}
