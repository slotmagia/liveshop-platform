{
  "id": "platform.admin.settings",
  "surface": "admin",
  "kind": "page",
  "route": "/platform/settings",
  "title": "平台配置",
  "description": "读取和版本化修改平台配置文档。",
  "sort": 30,
  "requiredPermissions": [
    "platform.settings.read"
  ],
  "allowedRoutes": [
    {
      "methods": [
        "GET"
      ],
      "prefix": "/admin/platform/settings",
      "requiredPermissions": [
        "platform.settings.read"
      ]
    },
    {
      "methods": [
        "PUT"
      ],
      "prefix": "/admin/platform/settings",
      "requiredPermissions": [
        "platform.settings.write"
      ]
    }
  ],
  "artifact": {
    "type": "iframe",
    "name": "@liveshop/platform-iam-admin",
    "version": "2.0.1",
    "entry": "http://127.0.0.1:5180",
    "integrity": "sha256:dev-platform-iam"
  },
  "frontend": {
    "component": "PlatformSettingsPage",
    "props": [],
    "events": [
      {
        "name": "platform.settings.changed",
        "description": "配置写入成功后发布。",
        "payload": [
          {
            "name": "namespace",
            "type": "string",
            "required": true,
            "description": "配置命名空间"
          },
          {
            "name": "version",
            "type": "integer",
            "required": true,
            "description": "最新版本"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "save-setting",
        "label": "保存配置",
        "description": "使用 expectedVersion 保存配置。",
        "invocation": "http",
        "target": "platform.settings.put",
        "parameters": [
          {
            "name": "namespace",
            "type": "string",
            "required": true,
            "description": "命名空间"
          }
        ],
        "requiredPermissions": [
          "platform.settings.write"
        ]
      }
    ]
  }
}
