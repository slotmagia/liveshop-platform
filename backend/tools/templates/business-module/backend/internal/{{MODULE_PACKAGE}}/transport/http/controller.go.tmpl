package http

import (
	"context"

	v1 "{{GO_MODULE}}/backend/api/merch/{{MODULE_PACKAGE}}/v1"
	"{{GO_MODULE}}/backend/internal/{{MODULE_PACKAGE}}/application"
)

type Controller struct{ service *application.Service }

func NewController(service *application.Service) *Controller { return &Controller{service: service} }

func (c *Controller) Health(ctx context.Context, _ *v1.HealthReq) (*v1.HealthRes, error) {
	if err := c.service.Health(ctx); err != nil {
		return nil, err
	}
	return &v1.HealthRes{Status: "ok"}, nil
}
